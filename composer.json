{
    "name": "ozodbekphp/laravel-imei-reader",
    "description": "High-performance PHP & Laravel package to decode barcodes and extract 15-digit IMEIs from Base64 images with Luhn validation.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/ozodbekphp/laravel-imei-reader",
    "support": {
        "issues": "https://github.com/ozodbekphp/laravel-imei-reader/issues",
        "source": "https://github.com/ozodbekphp/laravel-imei-reader"
    },
    "keywords": [
        "php",
        "laravel",
        "imei",
        "barcode",
        "code128",
        "code39",
        "ean13",
        "qr-code",
        "base64",
        "imei-reader",
        "luhn"
    ],
    "authors": [
        {
            "name": "Ozodbek Qurbonov",
            "email": "qurbonovo2008@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.1 || ^8.2 || ^8.3 || ^8.4",
        "ext-gd": "*",
        "ext-json": "*",
        "ext-ctype": "*",
        "khanamiryan/qrcode-detector-decoder": "^1.0 || ^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0 || ^11.0",
        "orchestra/testbench": "^8.0 || ^9.0 || ^10.0"
    },
    "autoload": {
        "files": [
            "src/Support/helpers.php"
        ],
        "psr-4": {
            "Ozodbek\\LaravelImeiReader\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ozodbek\\LaravelImeiReader\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Ozodbek\\LaravelImeiReader\\ImeiReaderServiceProvider"
            ],
            "aliases": {
                "ImeiReader": "Ozodbek\\LaravelImeiReader\\Facades\\ImeiReader"
            }
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "kylekatarnls/update-helper": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
